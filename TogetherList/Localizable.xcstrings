            "state": "translated",
            "value": "Ty"
          }
        }
      }
    },
    "You can reconnect later with a new invitation.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możecie połączyć się ponownie nowym zaproszeniem."
          }
        }
      }
    },
    "You don't share any lists right now.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dzielicie teraz żadnych list."
          }
        }
      }
    },
    "You need to be online to change the currency.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zmienić walutę, musisz być online."
          }
        }
      }
    },
    "You need to be online to create an invitation.": {
      "extractionState": "manual",
      "localizations": {
