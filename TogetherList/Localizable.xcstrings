    "What did you buy?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co kupiono?"
          }
        }
      }
    },
    "When you finish shopping, tap **Check out** in a list to record what you bought and who paid.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakupach stuknij **Rozlicz** na liście, żeby zapisać, co kupiono i kto płacił."
          }
        }
      }
    },
