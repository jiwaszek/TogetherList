    "To buy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do kupienia"
          }
        }
      }
    },
    "To scan invitation codes, allow camera access in Settings. You can also paste an invitation link below.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby skanować kody zaproszeń, zezwól na dostęp do aparatu w Ustawieniach. Możesz też wkleić link zaproszenia poniżej."
          }
        }
      }
    },
    "To share another of your lists, open it and tap Share — %@ appears under Your connections.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby udostępnić inną swoją listę, otwórz ją i stuknij Udostępnij — %@ pojawi się w sekcji Twoje połączenia."
          }
        }
      }
    },
