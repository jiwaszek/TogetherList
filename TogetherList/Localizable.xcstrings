    "%@ will lose access to %@.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ straci dostęp do %@."
          }
        }
      }
    },
    "%@ will lose access to “%@”. You'll stay connected, and other shared lists aren't affected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ will lose access to “%2$@”. You'll stay connected, and other shared lists aren't affected."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ straci dostęp do „%@”. Pozostaniecie połączeni, a inne wspólne listy się nie zmienią."
          }
        }
      }
    },
    "%@ will manage members and can delete the list. You'll stay on the list as a member.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ będzie zarządzać osobami na liście i będzie mogło ją usunąć. Ty zostaniesz na liście."
          }
        }
      }
    },
    "%@, %@, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@, %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@, %@"
          }
        }
      }
    },
