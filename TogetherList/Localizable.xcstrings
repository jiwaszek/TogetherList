            "state": "translated",
            "value": "Aby utworzyć zaproszenie, musisz być online."
          }
        }
      }
    },
    "You need to be online to record a payment.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zapisać wpłatę, musisz być online."
          }
        }
      }
    },
    "You no longer have access to this list.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
