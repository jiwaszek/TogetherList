          }
        }
      }
    },
    "Type an item and press return. You can add several in a row.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz produkt i naciśnij Enter. Możesz dodać kilka po kolei."
          }
        }
      }
    },
    "Type below to add items. Try “2 kg apples” or “6 eggs”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz poniżej, żeby dodać produkty. Spróbuj „2 kg jabłek” albo „6 jajek”."
          }
        }
      }
    },
    "Unit (kg, l, pcs…)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostka (kg, l, szt.…)"
