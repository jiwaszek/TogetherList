    "System (%@)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemowy (%@)"
          }
        }
      }
    },
    "Tap someone to record a payment once the money has been sent, for example by bank transfer or BLIK.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij osobę, żeby zapisać wpłatę, gdy pieniądze zostaną wysłane, np. przelewem lub BLIKIEM."
          }
        }
      }
    },
    "That isn't a TogetherList invitation.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest zaproszenie TogetherList."
          }
        }
      }
    },
    "The amount goes back into the balance for both of you.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwota wróci do rozliczenia po obu stronach."
          }
        }
      }
    },
    "The category is guessed from the name. Pick one to move this item for everyone on the list.": {
      "comment": "Item editor footer under the category picker",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria jest rozpoznawana po nazwie. Wybierz inną, aby przenieść produkt dla wszystkich na liście."
          }
        }
      }
    },
    "The code only grants access to this list. It stops working when it expires or you cancel it — people who already joined stay members until you remove them.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod daje dostęp tylko do tej listy. Przestaje działać, gdy wygaśnie lub go anulujesz — osoby, które już dołączyły, zostają na liście, dopóki ich nie usuniesz."
          }
        }
      }
    },
    "The list and all items will be deleted for everyone.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista i wszystkie produkty zostaną usunięte dla wszystkich."
          }
        }
      }
    },
    "The list and all items will be deleted.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista i wszystkie produkty zostaną usunięte."
          }
        }
      }
    },
    "The list and its items will be deleted for everyone it's shared with.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista i jej produkty zostaną usunięte dla wszystkich, którym ją udostępniono."
          }
        }
      }
    },
    "The list and its items will be deleted.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista i jej produkty zostaną usunięte."
          }
        }
      }
    },
    "The list owner cancelled this invitation. Ask them for a new one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszenie zostało anulowane przez właściciela listy. Poproś o nowe."
          }
        }
      }
    },
    "These lists belong to other people and stay with them. Items you added remain, shown as from a former member.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te listy należą do innych osób i u nich zostaną. Dodane przez ciebie produkty pozostaną, oznaczone jako dodane przez nieznaną osobę."
          }
        }
      }
    },
    "They'll be removed for everyone on this list.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną usunięte dla wszystkich na tej liście."
          }
        }
      }
    },
    "They'll be removed from the list.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaną usunięte z listy."
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie można cofnąć."
          }
        }
      }
    },
    "This code isn't valid. Check that you scanned the right QR code or copied the full link.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod jest nieprawidłowy. Sprawdź, czy to właściwy kod QR i czy skopiowano cały link."
          }
        }
      }
    },
    "This is your invitation": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To twoje zaproszenie"
          }
        }
      }
    },
    "This item was deleted by someone else.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten produkt został usunięty przez kogoś innego."
          }
        }
      }
    },
    "This list is empty. You can still record what you spent.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista jest pusta. Nadal możesz zapisać, ile wydano."
          }
        }
      }
    },
    "This list was deleted or you no longer have access to it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista została usunięta albo nie masz już do niej dostępu."
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten miesiąc"
          }
        }
      }
    },
    "This purchase is no longer in your history.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
