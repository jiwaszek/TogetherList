// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// Find both values in the Supabase dashboard: Project Settings → API.
// Use the PUBLISHABLE / anon key. NEVER put the service_role / secret key here.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = YOUR-PUBLISHABLE-OR-ANON-KEY

// Local Supabase CLI stack instead:
// SUPABASE_URL = http:/$()/127.0.0.1:54321
