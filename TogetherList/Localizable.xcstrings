          "stringUnit": {
            "state": "translated",
            "value": "Stracisz dostęp do %@."
          }
        }
      }
    },
    "You'll lose access to this list. The owner can invite you again.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stracisz dostęp do tej listy. Właściciel może zaprosić cię ponownie."
          }
