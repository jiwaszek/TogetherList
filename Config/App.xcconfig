// TogetherList build configuration.
//
// Backend settings live in Secrets.xcconfig (git-ignored). Create it with:
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// and fill in your Supabase project URL and publishable (anon) key.
//
// Note: "//" starts a comment in xcconfig files, so URLs are written as
// https:/$()/example.com  — the empty $() expands to nothing.

SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =
// Optional. Set when you host universal links, e.g. https:/$()/lists.example.com
// Leave empty to share togetherlist:// links.
INVITE_LINK_BASE_URL =

#include? "Secrets.xcconfig"
