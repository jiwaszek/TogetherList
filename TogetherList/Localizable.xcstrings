    "Up to date": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualne"
          }
        }
      }
    },
    "Used for new purchases and payments. Amounts already recorded keep their currency.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używana przy nowych zakupach i wpłatach. Zapisane kwoty zachowują swoją walutę."
